<?php
/**
 * Plugin Name: WooCommerce Dynamic Price Modifier
 * Description: Dynamically adjusts product prices in cart and checkout based on rules.
 * Version: 1.0
 */

function wdt_apply_dynamic_user_discount( $cart ) {
    if ( is_admin() && ! defined( 'DOING_AJAX' ) ) {
        return;
    }

    // Example: Apply a 10% discount for logged-in users who have a specific meta flag
    if ( is_user_logged_in() ) {
        $current_user_id = get_current_user_id();
        $is_vip = get_user_meta( $current_user_id, '_wdt_is_vip_customer', true );

        if ( $is_vip ) {
            foreach ( $cart->get_cart() as $cart_item_key => $cart_item ) {
                $original_price = $cart_item['data']->get_price();
                // Apply 10% VIP discount
                $discounted_price = $original_price * 0.90;
                $cart_item['data']->set_price( $discounted_price );
            }
        }
    }
}
add_action( 'woocommerce_before_calculate_totals', 'wdt_apply_dynamic_user_discount', 10, 1 );
