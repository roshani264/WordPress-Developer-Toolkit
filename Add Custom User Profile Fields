<?php
/**
 * Plugin Name: Custom User Profile Fields
 * Description: Adds custom fields to the WordPress user profile screen.
 * Version: 1.0
 */

// Add fields to profile page
function wdt_add_custom_user_profile_fields( $user ) {
    ?>
    <h3><?php _e( 'Extra Profile Information', 'wordpress-developer-toolkit' ); ?></h3>
    <table class="form-table">
        <tr>
            <th><label for="phone_number"><?php _e( 'Phone Number', 'wordpress-developer-toolkit' ); ?></label></th>
            <td>
                <input type="text" name="phone_number" id="phone_number" value="<?php echo esc_attr( get_the_author_meta( 'phone_number', $user->ID ) ); ?>" class="regular-text" /><br />
                <span class="description"><?php _e( 'Please enter your contact phone number.', 'wordpress-developer-toolkit' ); ?></span>
            </td>
        </tr>
    </table>
    <?php
}
add_action( 'show_user_profile', 'wdt_add_custom_user_profile_fields' );
add_action( 'edit_user_profile', 'wdt_add_custom_user_profile_fields' );

// Save custom fields
function wdt_save_custom_user_profile_fields( $user_id ) {
    if ( ! current_user_can( 'edit_user', $user_id ) ) {
        return false;
    }
    update_user_meta( $user_id, 'phone_number', sanitize_text_field( $_POST['phone_number'] ) );
}
add_action( 'personal_options_update', 'wdt_save_custom_user_profile_fields' );
add_action( 'edit_user_profile_update', 'wdt_save_custom_user_profile_fields' );
